{
  "name": "fastforward",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx apps/api/src/worker-main.ts",
    "dev:web": "npm run dev --workspace @fastforward/web",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/supervisor.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test apps/api/test/*.test.ts",
    "build": "npm run build --workspace @fastforward/web",
    "verify:integration": "npm run build && tsx scripts/verify-built-app.ts",
    "providers:check": "node --env-file-if-exists=.env --import tsx apps/api/src/preflight-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@nodeops-createos/sandbox": "0.8.2",
    "clsx": "2.1.1",
    "fastify": "5.12.7",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stripe/cli": "1.54.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
