# Server only. Never use VITE_ for any provider credential.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
FASTFORWARD_DATA_DIR=.local/data
FASTFORWARD_SESSION_SECRET=
# Organiser's event-specific EU endpoint; verify actual account allocation.
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh
CREATEOS_SANDBOX_API_KEY=
CREATEOS_SANDBOX_SHAPE=s-1vcpu-1gb
STRIPE_SECRET_KEY=
# Restricted TEST key: only required reads; no subscription mutations.
STRIPE_READONLY_KEY=
STRIPE_READONLY_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Explicit operator budgets. Zero disables spending until configured.
MAX_MODEL_CALLS_PER_RUN=0
MODEL_MAX_OUTPUT_TOKENS=0
MAX_RUNS_PER_DAY=0
RUN_TIMEOUT_SECONDS=600
# Provisioned only during the event; secrets remain local/provider-managed.
STRIPE_PROJECT_ID=
